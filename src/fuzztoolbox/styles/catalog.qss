/* @style tools.screenshot.overlay:workspace
QFrame#screenshotToolbar { background: #202b3a; border: 1px solid #46556a; border-radius: 9px; }
QFrame#screenshotToolbar QPushButton { color: #edf2f7; background: transparent; border: 0; border-radius: 5px; padding: 0 8px; }
QFrame#screenshotToolbar QPushButton:hover { background: #344154; }
QFrame#screenshotToolbar QPushButton:checked { color: #ffffff; background: #409eff; }
QFrame#screenshotToolbar QPushButton#screenshotFinishButton { color: #ffffff; background: #409eff; }
QFrame#screenshotToolbar QPushButton#screenshotFinishButton:hover { background: #1677d2; }
QFrame#screenshotPopup { background: #202b3a; border: 1px solid #526176; border-radius: 9px; }
QFrame#screenshotPopup QLabel { color: #edf2f7; background: transparent; font-weight: 600; }
QFrame#screenshotPopup QPushButton#screenshotPopupButton { color: #edf2f7; background: #344154; border: 1px solid #526176; border-radius: 5px; padding: 5px 10px; }
QFrame#screenshotPopup QPushButton#screenshotPopupButton:hover { background: #435269; }
QFrame#screenshotPopup QSlider { background: transparent; }
QFrame#screenshotPopup QSlider::groove:horizontal { height: 5px; background: #4b5b70; border: 0; border-radius: 2px; }
QFrame#screenshotPopup QSlider::sub-page:horizontal { background: #409eff; border-radius: 2px; }
QFrame#screenshotPopup QSlider::add-page:horizontal { background: #4b5b70; border-radius: 2px; }
QFrame#screenshotPopup QSlider::handle:horizontal { width: 15px; margin: -5px 0; background: #ffffff; border: 2px solid #409eff; border-radius: 7px; }
QFrame#screenshotPopup QDoubleSpinBox { color: #edf2f7; background: #172230; border: 1px solid #526176; border-radius: 5px; padding: 4px 6px; }
QFontComboBox#screenshotFontCombo { color: #edf2f7; background: #172230; border: 1px solid #526176; border-radius: 5px; padding: 5px 9px; selection-background-color: #409eff; }
QFontComboBox#screenshotFontCombo:hover, QFontComboBox#screenshotFontCombo:focus { border-color: #409eff; }
QFontComboBox#screenshotFontCombo::drop-down { width: 28px; border: 0; background: #263447; }
QFontComboBox#screenshotFontCombo QAbstractItemView { color: #edf2f7; background: #172230; border: 1px solid #526176; outline: 0; selection-color: #ffffff; selection-background-color: #409eff; }
QAbstractItemView#screenshotFontList { color: #edf2f7; background: #172230; border: 1px solid #526176; outline: 0; selection-color: #ffffff; selection-background-color: #409eff; }
QScrollBar#screenshotFontScrollBar:vertical { width: 12px; margin: 2px; border: 0; border-radius: 5px; background: #172230; }
QScrollBar#screenshotFontScrollBar::handle:vertical { min-height: 28px; border: 0; border-radius: 4px; background: #526176; }
QScrollBar#screenshotFontScrollBar::handle:vertical:hover { background: #6b7d96; }
QScrollBar#screenshotFontScrollBar::add-line:vertical, QScrollBar#screenshotFontScrollBar::sub-line:vertical { height: 0; border: 0; background: transparent; }
QScrollBar#screenshotFontScrollBar::add-page:vertical, QScrollBar#screenshotFontScrollBar::sub-page:vertical { background: transparent; }
QLineEdit#screenshotTextEditor { color: #172230; background: rgba(255, 255, 255, 242); border: 2px solid #409eff; border-radius: 5px; padding: 5px 8px; selection-background-color: #409eff; }
QMenu#screenshotContextMenu { color: #edf2f7; background: #202b3a; border: 1px solid #526176; border-radius: 7px; padding: 5px; }
QMenu#screenshotContextMenu::item { min-width: 0; padding: 7px 11px; border-radius: 5px; }
QMenu#screenshotContextMenu::item:selected { color: #ffffff; background: #409eff; }
QFrame#screenshotSelectionOptions { color: #edf2f7; background: rgba(32, 43, 58, 238); border: 1px solid #526176; border-radius: 8px; }
QFrame#screenshotSelectionOptions QLabel { color: #edf2f7; background: transparent; border: 0; }
QLabel#screenshotSelectionResolution { min-width: 90px; font-weight: 700; }
QLabel#screenshotSelectionLabel { color: #c4cedb; font-weight: 600; }
QLabel#screenshotSelectionValue { color: #79bdff; font-weight: 700; }
QSlider#screenshotCornerSlider { min-height: 20px; background: transparent; }
QSlider#screenshotCornerSlider::groove:horizontal { height: 5px; background: #4b5b70; border: 0; border-radius: 2px; }
QSlider#screenshotCornerSlider::sub-page:horizontal { background: #409eff; border-radius: 2px; }
QSlider#screenshotCornerSlider::add-page:horizontal { background: #4b5b70; border-radius: 2px; }
QSlider#screenshotCornerSlider::handle:horizontal { width: 15px; margin: -5px 0; background: #ffffff; border: 2px solid #409eff; border-radius: 7px; }
@endstyle */

