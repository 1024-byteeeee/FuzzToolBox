{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FuzzToolBox：桌面版",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/packaging/macos_entry.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "FuzzToolBox：IP Scanner 命令行测试",
      "type": "debugpy",
      "request": "launch",
      "module": "ip_scanner.cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "127.0.0.1",
        "--method",
        "tcp",
        "--ports",
        "22,80,443",
        "--include-dead"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
